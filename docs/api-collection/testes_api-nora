              - name: Content-Type
                value: application/json
            scripts:
              afterResponse: |-
                const resp = insomnia.response.json();
                if (resp && resp.token) {
                    insomnia.collectionVariables.set('token', resp.token);
                    console.log('Token salvo automaticamente.');
                }
                insomnia.test('Login retorna 200', function () {
                    insomnia.response.to.have.status(200);
                });
                insomnia.test('Resposta contém token', function () {
                    insomnia.expect(resp).to.have.property('token');
                });
