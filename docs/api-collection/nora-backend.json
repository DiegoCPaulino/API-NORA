          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/conversas",
              "host": ["{{baseUrl}}"],
              "path": ["conversas"],
              "query": [
                { "key": "contexto", "value": "", "disabled": true },
                { "key": "stts", "value": "", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "GET /conversas/{id}",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/conversas/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "POST /conversas",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/conversas",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalConv\": \"telegram\",\n  \"contexto\": \"cadastro\",\n  \"idPessoa\": 1,\n  \"naoLidas\": 0\n}"
            }
          }
        },
        {
          "name": "GET /conversas/{id}/mensagens",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/conversas/1/mensagens",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Mensagens",
      "item": [
        {
          "name": "POST /mensagens",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/mensagens",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
