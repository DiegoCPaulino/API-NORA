{
  "info": {
    "name": "Nora Backend Java",
    "description": "Projeto Nora — Backend Java (Quarkus 3.34.6). Coleção Postman v2.1. Configurar variável baseUrl e token antes de usar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string", "description": "Preencher com o token retornado pelo POST /auth/login" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"colaborador@nora.com\",\n  \"senha\": \"senha123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Pessoas",
      "item": [
        {
          "name": "GET /pessoas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pessoas",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "GET /pessoas/{id}",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pessoas/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "POST /pessoas",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pessoas",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idEndereco\": 1,\n  \"nomeCompleto\": \"Maria Teste da Silva\",\n  \"dataNascimento\": \"2012-06-15\",\n  \"idade\": 13,\n  \"sexo\": \"F\",\n  \"telefone\": \"11999990001\",\n  \"canalOrig\": \"telegram\"\n}"
            }
          }
        },
        {
          "name": "PUT /pessoas/{id}",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/pessoas/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idEndereco\": 1,\n  \"nomeCompleto\": \"Maria Teste da Silva\",\n  \"dataNascimento\": \"2012-06-15\",\n  \"idade\": 13,\n  \"telefone\": \"11999990002\",\n  \"canalOrig\": \"telegram\",\n  \"sttsPess\": \"lead\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Triagens",
      "item": [
        {
          "name": "GET /triagens",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/triagens",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "POST /triagens",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/triagens",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPessoa\": 1,\n  \"problemaBucal\": \"Dor de dente persistente ha 2 semanas com inchaco\",\n  \"rendaFamiliar\": \"ate_1sm\"\n}"
            }
          }
        },
        {
          "name": "PUT /triagens/{id}",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/triagens/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPessoa\": 1,\n  \"problemaBucal\": \"Dor de dente persistente\",\n  \"rendaFamiliar\": \"ate_1sm\",\n  \"observacoes\": \"Atualizado pelo atendente\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Aprovação",
      "item": [
        {
          "name": "POST /triagens/{id}/aprovar",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/triagens/1/aprovar",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
